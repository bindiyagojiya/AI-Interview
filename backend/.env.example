# Application Settings
PROJECT_NAME="InterviewIQ AI"
API_V1_STR="/api/v1"
SECRET_KEY="replace_this_with_a_secure_random_hex_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 18)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/interviewiq_db"

# AI / LLM Configuration
# Leave blank to use deterministic offline fallback evaluator
GEMINI_API_KEY=""

# CORS Settings
# Comma-separated list of origins
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8081,http://10.0.2.2:8081"

